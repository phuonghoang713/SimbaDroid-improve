<!-- Backup rules for Android 12 and later, see backup_rules.xml for earlier versions.
     The server settings contain the access password, so they are neither backed up to the cloud nor
     transferred to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="server_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server_settings.xml" />
    </device-transfer>
</data-extraction-rules>
